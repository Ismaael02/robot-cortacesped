{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo \"sin dependencias\"",
  "buildCommand": "echo \"dist ya viene generado\"",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
